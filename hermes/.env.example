# Hermes configuration. Copy this file to `.env` and fill in your values.
# All values are read from environment variables (prefix HERMES_).

# --- General ---
HERMES_ENVIRONMENT=development
HERMES_LOG_LEVEL=INFO
HERMES_DATABASE_URL=sqlite+aiosqlite:///./data/hermes.db
HERMES_RULES_FILE=app/config/rules.yaml
HERMES_TEMPLATES_DIR=app/templates
HERMES_MAX_PAGINATION_LIMIT=100

# --- Queue / delivery ---
HERMES_WORKER_CONCURRENCY=4
HERMES_WORKER_SWEEP_INTERVAL=30
HERMES_NOTIFICATION_MAX_ATTEMPTS=3
HERMES_NOTIFICATION_RETRY_BASE_DELAY=1.0

# --- Discord (optional) ---
# https://discord.com/api/webhooks/<id>/<token>
HERMES_DISCORD_WEBHOOK_URL=

# --- Telegram (optional) ---
HERMES_TELEGRAM_BOT_TOKEN=
HERMES_TELEGRAM_CHAT_ID=

# --- Email / SMTP (optional) ---
HERMES_SMTP_HOST=
HERMES_SMTP_PORT=587
HERMES_SMTP_USERNAME=
HERMES_SMTP_PASSWORD=
HERMES_SMTP_FROM=
HERMES_SMTP_TO=
HERMES_SMTP_USE_TLS=true
HERMES_SMTP_USE_SSL=false

# --- ntfy (optional) ---
HERMES_NTFY_URL=https://ntfy.sh
HERMES_NTFY_TOPIC=
HERMES_NTFY_TOKEN=

# --- Generic webhook (optional) ---
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=

# --- Storm detection (optional) ---
# Collapses bursts of repeated (module, type) events into one event.storm event.
HERMES_STORM_ENABLED=false
HERMES_STORM_WINDOW_SECONDS=60
HERMES_STORM_THRESHOLD=20
HERMES_STORM_COOLDOWN_SECONDS=300
HERMES_STORM_CHECK_INTERVAL=10

# --- Remediation (optional) ---
# Enables `action: remediate` rules (http / command / docker_restart).
# Command remediations are restricted to these fnmatch patterns (comma-separated).
# Example: systemctl restart *, docker restart *
HERMES_REMEDIATION_ENABLED=false
HERMES_REMEDIATION_MAX_ATTEMPTS=1
HERMES_REMEDIATION_RETRY_BASE_DELAY=1.0
HERMES_REMEDIATION_ALLOWED_COMMANDS=

# --- Telegram inbound bot (optional) ---
# Lets the authorized chat(s) in HERMES_TELEGRAM_CHAT_ID query Hermes
# (/status, /alerts, /events, /providers, /health, /cmd).
HERMES_BOT_ENABLED=false
HERMES_BOT_ALLOW_CMD=false
# Restrict /cmd to these fnmatch patterns (comma-separated); empty = any command.
# Example: ls *, docker ps *, docker restart *
HERMES_BOT_ALLOWED_COMMANDS=
HERMES_BOT_MAX_OUTPUT_CHARS=3500
HERMES_BOT_RATE_LIMIT_PER_MINUTE=10
# Netdata used by the bot's /health command. From inside the container use
# host.docker.internal (add `extra_hosts: host-gateway` in docker-compose).
HERMES_NETDATA_URL=http://127.0.0.1:19999

# --- AI / Oracle (optional) ---
# Answers plain (non-command) Telegram messages by asking the Oracle gateway
# running on the laptop (`ak`, 100.84.233.111) over the tailnet. Use the same
# token as ORACLE_SHARED_TOKEN in the oracle/.env file.
HERMES_AI_ENABLED=false
HERMES_ORACLE_URL=http://100.84.233.111:8003
HERMES_ORACLE_TOKEN=
HERMES_AI_MAX_HISTORY=10
HERMES_AI_TIMEOUT=60
# Send a live-state snapshot (events, alerts, health) with each question.
HERMES_AI_CONTEXT_ENABLED=true
HERMES_AI_CONTEXT_EVENTS=10
# Per-chat AI history is persisted in SQLite for at most this many days.
HERMES_AI_HISTORY_MAX_AGE_DAYS=30

# --- AI watchdog (monitor + manager, optional) ---
# Background loop that watches the event stream, asks the Oracle gateway
# whether an allow-listed recovery action is warranted, and auto-runs
# low-risk fixes after a veto window unless the operator replies.
HERMES_WATCHDOG_ENABLED=false
HERMES_WATCHDOG_CHECK_INTERVAL=30
# Seconds the operator has to veto a low-risk proposal before it runs.
HERMES_WATCHDOG_CONFIRM_SECONDS=180
# Minimum seconds between proposing an action for the same target.
HERMES_WATCHDOG_TARGET_COOLDOWN_SECONDS=900
HERMES_WATCHDOG_MAX_EVENTS_PER_CHECK=3
# Fail-closed: only these fnmatch patterns may ever be auto-run.
HERMES_WATCHDOG_ALLOWED_COMMANDS=docker restart *,docker start *,docker stop *,docker logs *,docker inspect *,docker ps *

# --- Forge approval bridge ---------------------------------------------------
# Forge is the execution layer. At Level 1 its act tools require a human
# thumbs-up: Forge POSTs an approval here, Hermes relays it to Telegram and
# routes the operator's yes/no reply back to Forge's resolve endpoint.
HERMES_FORGE_ENABLED=false
HERMES_FORGE_URL=http://forge:8000
# Bearer token Forge requires (must match FORGE_TOKEN in the forge/.env).
HERMES_FORGE_TOKEN=
# Seconds an operator has to answer before the approval is treated as stale.
HERMES_FORGE_APPROVAL_TIMEOUT=900
