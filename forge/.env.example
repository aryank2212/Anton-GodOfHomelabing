# Forge configuration. Copy to `.env` and set real values.
# All values are read from environment variables (prefix FORGE_).

# --- Access control ----------------------------------------------------------
# Bearer token required for every /v1/* route (Hermes and the Oracle agent use
# this to call Forge). MUST be set — without it Forge refuses to serve /v1/*.
FORGE_TOKEN=changeme-long-random-hex

# --- Environment ------------------------------------------------------------
FORGE_ENVIRONMENT=production
FORGE_LOG_LEVEL=INFO

# --- Policy / state / audit --------------------------------------------------
FORGE_CONFIG_FILE=/app/forge.yaml
FORGE_STATE_FILE=/data/forge-state.json
FORGE_AUDIT_FILE=/data/forge-audit.jsonl

# --- Upstreams ---------------------------------------------------------------
# Hermes and Phoenix resolve over the shared docker network (service names).
FORGE_HERMES_URL=http://hermes:8000
FORGE_PHOENIX_URL=http://phoenix:8010
# Watcher API is exposed on the host bridge (not on anton-net).
FORGE_WATCHER_URL=http://host.docker.internal:8008

# --- Approvals ---------------------------------------------------------------
# Seconds an operator has to approve a Level-1 action before it expires.
FORGE_APPROVAL_TIMEOUT=600
