# Argus configuration. Copy this file to `.env` and fill in your values.
# All values are read from environment variables (prefix ARGUS_).

# --- General ---
ARGUS_ENVIRONMENT=development
ARGUS_LOG_LEVEL=INFO
ARGUS_VERSION=1.0.0

# --- Paths ---
# Where sources.yaml lives (absolute path inside the container; ./config is
# mounted onto /app/config so sources can be tuned without rebuilding).
ARGUS_CONFIG_DIR=/app/config
ARGUS_DATABASE_URL=sqlite+aiosqlite:///./data/argus.db

# --- API ---
ARGUS_API_HOST=0.0.0.0
ARGUS_API_PORT=8012

# --- Collectors ---
# Comma-separated collector kinds; empty string disables all collectors.
ARGUS_COLLECTORS=rss,scrape,osint,telegram
ARGUS_COLLECTOR_TIMEOUT=30
ARGUS_COLLECTOR_JITTER=2.0

# --- Command-center web UI auth ---
# Bearer token required for MUTATING routes only (start/cancel dot
# investigations, create/cancel research sessions, manage dot watches) via the
# web UI or API. Monitoring/read-only GETs stay open. Leave empty to keep
# command routes unauthenticated (not recommended when exposed on the internet).
ARGUS_COMMAND_TOKEN=

# --- Intelligence layer ---
ARGUS_INTELLIGENCE_SCAN_INTERVAL=30
ARGUS_EXTRACTION_ENABLED=true
ARGUS_HYPOTHESIS_ENABLED=true
ARGUS_REPORT_MIN_CONFIDENCE=0.7

# --- Oracle (LLM gateway on the laptop over Tailscale) ---
# Oracle enriches extraction and hypothesis generation. Same token as
# ORACLE_SHARED_TOKEN in the oracle/.env file.
ARGUS_ORACLE_ENABLED=false
ARGUS_ORACLE_BASE_URL=http://100.84.233.111:8003
ARGUS_ORACLE_TOKEN=
# Generous timeout: qwen3:8b extraction can take tens of seconds to minutes.
ARGUS_ORACLE_TIMEOUT=300
# Separate, short cap for opening the connection (hung tailnet link).
ARGUS_ORACLE_CONNECT_TIMEOUT=10
# Retry transient failures (network errors / 429 / 5xx) with backoff.
ARGUS_ORACLE_RETRY_ATTEMPTS=2
ARGUS_ORACLE_RETRY_BACKOFF=2.0
ARGUS_ORACLE_EXTRACTION_ENABLED=false
ARGUS_ORACLE_HYPOTHESIS_ENABLED=false
# Only enrich items that already carry a deterministic CVE (keeps slow LLM
# extraction affordable on large feed batches).
ARGUS_ORACLE_EXTRACTION_ONLY_CVES=true

# --- Hermes integration ---
# Argus publishes notable findings here. Hermes owns all notifications.
ARGUS_HERMES_ENABLED=true
ARGUS_HERMES_BASE_URL=http://127.0.0.1:8002
ARGUS_HERMES_TIMEOUT=5
ARGUS_HERMES_RETRY_ATTEMPTS=2
ARGUS_HERMES_RETRY_BACKOFF=1.0

# --- Dot-matching investigations ---
# On-demand web investigations. Search + fetch run here; all reasoning is
# delegated to Oracle. Requires ARGUS_ORACLE_ENABLED=true.
ARGUS_DOTS_ENABLED=false
ARGUS_DOTS_DEFAULT_ITERATIONS=12
ARGUS_DOTS_QUERIES_PER_ROUND=3
ARGUS_DOTS_MAX_ITEMS_PER_ROUND=12
ARGUS_DOTS_SCRAPE_CONCURRENCY=4
ARGUS_DOTS_SCRAPE_TIMEOUT=12
ARGUS_DOTS_WORKER_INTERVAL=1
ARGUS_DOTS_SUBBATCHES=4
ARGUS_DOTS_BATCH_COOLDOWN_SECONDS=30
ARGUS_DOTS_MAX_RUN_SECONDS=1800
ARGUS_DOTS_WATCH_ENABLED=false
ARGUS_DOTS_WATCH_INTERVAL=60

# --- Research sessions ---
# Goal-directed sessions (one question -> angles -> synthesised report) that
# run dot investigations; requires ARGUS_DOTS_ENABLED and ARGUS_ORACLE_ENABLED.
ARGUS_RESEARCH_ENABLED=true
ARGUS_RESEARCH_WORKER_INTERVAL=5
ARGUS_RESEARCH_MAX_ANGLES=3
ARGUS_RESEARCH_MAX_ATTEMPTS=2
ARGUS_RESEARCH_MAX_ROUNDS=3
# Information-gain stopping: an adaptive round only runs when Oracle rates its
# expected marginal gain >= this. 0 disables the rule (always continue when
# the assessor asks for more).
ARGUS_RESEARCH_MIN_INFORMATION_GAIN=0.0
