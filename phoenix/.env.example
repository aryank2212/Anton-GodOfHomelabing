# Phoenix configuration. Copy this file to `.env` and fill in your values.
# All values are read from environment variables (prefix PHOENIX_).

# --- General ---
PHOENIX_ENVIRONMENT=development
PHOENIX_LOG_LEVEL=INFO
PHOENIX_VERSION=1.0.0

# --- Paths ---
# Where the YAML-driven monitoring / recovery / dependency configuration lives.
PHOENIX_CONFIG_FILE=app/config/phoenix.yaml

# --- Database ---
# Persistent incident history. Override the URL when running in Docker.
PHOENIX_DATABASE_URL=sqlite+aiosqlite:///./data/phoenix.db

# --- API ---
PHOENIX_API_HOST=0.0.0.0
PHOENIX_API_PORT=8010

# --- Scheduler ---
PHOENIX_SCHEDULER_TICK_INTERVAL=10
PHOENIX_SCHEDULER_MAX_CONCURRENT_CHECKS=8

# --- Hermes integration ---
# Phoenix publishes standardized events here. Hermes owns all notifications.
PHOENIX_HERMES_ENABLED=true
PHOENIX_HERMES_BASE_URL=http://127.0.0.1:8000
PHOENIX_HERMES_TIMEOUT=5
PHOENIX_HERMES_RETRY_ATTEMPTS=2
PHOENIX_HERMES_RETRY_BACKOFF=1.0
