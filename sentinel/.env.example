# Sentinel configuration. Copy this file to `.env` and fill in your values.
# All values are read from environment variables (prefix SENTINEL_).

# --- General ---
SENTINEL_ENVIRONMENT=development
SENTINEL_LOG_LEVEL=INFO
SENTINEL_VERSION=1.0.0

# --- Paths ---
# Where the YAML files live (observers.yaml, rules.yaml, devices.yaml, vendors.yaml).
SENTINEL_CONFIG_DIR=app/config
# Local data (SQLite database). Override in Docker via volume mount.
SENTINEL_DATABASE_URL=sqlite+aiosqlite:///./data/sentinel.db

# --- API ---
SENTINEL_API_HOST=0.0.0.0
SENTINEL_API_PORT=8011

# --- Observers ---
# Comma-separated observer names; empty string disables all observers.
# Each observer can also be switched on/off in observers.yaml.
SENTINEL_OBSERVERS=system,docker,router,watcher,ups,http,network
SENTINEL_OBSERVER_TIMEOUT=10
SENTINEL_OBSERVER_JITTER=1.0

# --- Correlation engine ---
SENTINEL_CORRELATION_SCAN_INTERVAL=5
SENTINEL_CORRELATION_GRACE_SECONDS=60

# --- Presence engine ---
# Seconds without a sighting before a device is considered offline.
SENTINEL_PRESENCE_OFFLINE_AFTER=180
SENTINEL_PRESENCE_SCAN_INTERVAL=30

# --- Hermes integration ---
# Sentinel publishes standardized events here. Hermes owns all notifications.
SENTINEL_HERMES_ENABLED=true
SENTINEL_HERMES_BASE_URL=http://127.0.0.1:8002
SENTINEL_HERMES_TIMEOUT=5
SENTINEL_HERMES_RETRY_ATTEMPTS=2
SENTINEL_HERMES_RETRY_BACKOFF=1.0
