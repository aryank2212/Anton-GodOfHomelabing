# Oracle gateway configuration. Copy this file to `.env` and fill in your values.
# All values are read from environment variables (prefix ORACLE_).

# --- Model / generation ---
ORACLE_MODEL=qwen3:1.7b
# ORACLE_OLLAMA_URL=http://127.0.0.1:11434
# ORACLE_SYSTEM_PROMPT=You are Oracle, the AI assistant for Anton...
# ORACLE_TEMPERATURE=0.7
# ORACLE_MAX_HISTORY=10
# ORACLE_REQUEST_TIMEOUT=300

# --- Forge (agent execution) ---
# The /v1/agent loop relays tool calls to Forge on the Anton host over Tailscale.
# The token must match FORGE_TOKEN in /opt/anton/forge/.env.
# ORACLE_FORGE_URL=http://100.77.54.107:8092
ORACLE_FORGE_TOKEN=
# ORACLE_FORGE_TIMEOUT=60
# ORACLE_AGENT_TEMPERATURE=0.2
# ORACLE_AGENT_MAX_STEPS=5
# ORACLE_AGENT_TOOL_OUTPUT_LIMIT=4000
# ORACLE_AGENT_CONTEXT_BUDGET=20000

# --- Access control ---
# Clients (Hermes) must send this as `Authorization: Bearer <token>`.
ORACLE_SHARED_TOKEN=

# --- Listen address ---
# Prefer the Tailscale IP (e.g. 100.84.233.111) so only the tailnet can reach it.
ORACLE_HOST=0.0.0.0
ORACLE_PORT=8003
